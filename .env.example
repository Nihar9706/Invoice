# ── Off-chain Keeper script (scripts/keeper.js) ─────────────────────────────
# RPC endpoint — change to GoChain testnet when ready
RPC_URL=http://127.0.0.1:8545

# Wallet that submits keeper transactions (needs test ETH for gas)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Deployed contract addresses (fill after running deploy script)
INVOICE_ADDR=0x
KEEPER_ADDR=0x

# How often keeper polls (milliseconds). Default: 60000 = 1 minute
POLL_INTERVAL=60000


# ── Hardhat (for GoChain testnet deployment) ─────────────────────────────────
# Same private key used above — Hardhat reads this for gochain_testnet network
# GoChain Testnet Faucet: https://testnet-explorer.gochain.io/faucet
# GoChain Testnet RPC:    https://testnet-rpc.gochain.io
# GoChain Testnet Explorer: https://testnet-explorer.gochain.io

# Show gas usage in tests
# REPORT_GAS=true
